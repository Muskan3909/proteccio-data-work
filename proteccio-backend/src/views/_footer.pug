footer.worlenz_footer
  .container-fluid.main-nav-container
    .row.align-items-center.mb-block
      .col-3
        .Proteccio_footer_img
          img.img-fluid(src='/assets/images/Proteccio-logo.png' alt='')
      .col-6
        ul.Proteccio_page_list
          li
            a(href='/privacy-policy') Privacy Policy
          li
            a(href='/terms-of-use') Terms of Use
      .col-3.Proteccio_footer_nav_list
        .Proteccio_footer_social_list
          ul
            li
              a(href='https://www.facebook.com/Proteccio' target='_blank')
                i.fa-brands.fa-facebook-f
            li
              a(href='https://twitter.com/ProteccioHQ' target='_blank')
                i.fa-brands.fa-twitter
            li
              a(href='https://www.linkedin.com/showcase/Proteccio/' target='_blank')
                i.fa-brands.fa-linkedin-in
            li
              a(href='https://www.reddit.com/user/Proteccio' target='_blank')
                i.fa-brands.fa-reddit-alien
    .row
      .col-12.Proteccio_footer_copyrights.mt-4.justify-content-center
        span Proteccio &copy; <span id="date"></span>
