# ============================================================================
# Proteccio root .env.example
# Used by quick-setup.sh / manage.sh to generate the top-level .env
# Placeholders containing CHANGE_THIS are auto-replaced by quick-setup.sh
# ============================================================================

# Domain (quick-setup.sh will overwrite this based on your prompt answer)
DOMAIN=localhost

# Database
DB_USER=postgres
DB_NAME=proteccio_db
DB_PASSWORD=CHANGE_THIS

# Secrets (auto-generated by quick-setup.sh)
SESSION_SECRET=CHANGE_THIS
COOKIE_SECRET=CHANGE_THIS
JWT_SECRET=CHANGE_THIS
REDIS_PASSWORD=CHANGE_THIS

# MinIO / S3-compatible storage
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=CHANGE_THIS
AWS_SECRET_ACCESS_KEY=CHANGE_THIS

# URLs
FRONTEND_URL=http://localhost:5000
HOSTNAME=localhost:5000

# Docker Hub (only needed if pulling/pushing custom images)
DOCKER_USERNAME=
